POSTGRES_PASSWORD=local-dev
DATABASE_URL=postgresql://enterprise:local-dev@localhost:55432/enterprise_agent
TEST_DATABASE_URL=postgresql://enterprise:local-dev@localhost:55432/enterprise_agent
EMBEDDING_PROVIDER=model2vec
EMBEDDING_MODEL=minishlab/potion-base-8M
EMBEDDING_REVISION=bf8b056651a2c21b8d2565580b8569da283cab23
EMBEDDING_DIMENSIONS=256
OPENAI_API_KEY=
# Phase 3. Set the trusted allowlist for this instance before asking a question.
ANSWER_ACCESS_SCOPE='{"source_types":[]}'
ANSWER_PROVIDER=local
ANSWER_BASE_URL=http://127.0.0.1:8080/v1
ANSWER_MODEL=local-model
# PageIndex navigation uses a local Chat Completions server and the same trusted read scope.
PAGEINDEX_BASE_URL=http://127.0.0.1:8080/v1
PAGEINDEX_MODEL=local-model
PAGEINDEX_CONTEXT_TOKENS=8192
PAGEINDEX_MAX_CALLS=32
PAGEINDEX_CANDIDATES=20
PAGEINDEX_TIMEOUT_SECONDS=120
PAGEINDEX_DOCUMENT_BATCH_SIZE=20
# Optional path to the matching Hugging Face tokenizer.json and model weight revision/digest.
PAGEINDEX_TOKENIZER_PATH=
PAGEINDEX_MODEL_REVISION=
